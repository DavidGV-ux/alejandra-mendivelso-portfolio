{
  "name": "alejandra-mendivelso-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio 3D de Alejandra Mendivelso - Galería en espiral",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/content-pipeline.mjs",
    "dev": "vite",
    "prebuild": "node scripts/content-pipeline.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/content-pipeline.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,css,json}\"",
    "pretest": "node scripts/content-pipeline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/content-pipeline.mjs --check",
    "optimize:media": "node scripts/optimize-media.mjs",
    "placeholders": "node scripts/gen-placeholders.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
